# ==============================================================================
# Afterframe Environment Configuration (.env)
# ==============================================================================

# ------------------------------------------------------------------------------
# Google AI Studio / Gemini Configuration
# ------------------------------------------------------------------------------
# Replace YOUR_GEMINI_API_KEY with your Google AI Studio API key
LLM_API_KEY=YOUR_GEMINI_API_KEY

# Google AI Studio OpenAI-compatible chat completions base URL
LLM_BASE_URL=https://generativelanguage.googleapis.com/v1beta/openai

# Gemini 3.6 Flash model
LLM_MODEL=gemini-3.6-flash

# Optional request timeout in milliseconds
LLM_TIMEOUT_MS=30000

# ------------------------------------------------------------------------------
# Optional Infrastructure Configuration
# ------------------------------------------------------------------------------
PORT=3000
# DATABASE_URL=postgresql://user:pass@host:5432/afterframe
# PGLITE_DATA_DIR=./data/pglite
# YOUTUBE_CONNECTOR_ENABLED=true
